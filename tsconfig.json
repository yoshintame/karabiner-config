{
  "extends": ["@tsconfig/strictest", "@tsconfig/bun"],
  "compilerOptions": {
    "types": ["bun"],
    "lib": ["ES2024"],
    "target": "ES2024",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "resolveJsonModule": true,
    "noUncheckedSideEffectImports": true
  }
}
