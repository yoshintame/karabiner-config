{
  "name": "yoshintame-karabiner-config",
  "description": "yoshintame karabiner config in karabiner.ts",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "build": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "bun test",
    "depscheck": "knip"
  },
  "dependencies": {
    "es-toolkit": "1.53.2",
    "karabiner.ts": "1.38.0",
    "type-fest": "5.10.0"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "0.6.1",
    "@tsconfig/bun": "1.0.10",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.3",
    "@types/node": "25.9.2",
    "@yoshintame/ox-config": "0.2.0",
    "knip": "6.16.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "6.0.3"
  }
}
