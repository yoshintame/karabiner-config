{
  "name": "yoshintame-karabiner-config",
  "description": "yoshintame karabiner config in karabiner.ts",
  "scripts": {
    "generate:proxy": "bun run ../../../../packages/proxy-bindings/src/cli.ts generate -c ../../../../modules/shared/proxy-bindings.yaml",
    "dev": "MODE=development bun run src/index.ts",
    "prebuild": "bun run generate:proxy",
    "build": "MODE=build bun run src/index.ts",
    "check": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "commitlint": "commitlint --edit",
    "prepare": "husky install"
  },
  "dependencies": {
    "karabiner.ts": "latest",
    "type-fest": "^5.0.1",
    "es-toolkit": "^1.39.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^20.1.3",
    "husky": "^9.0.11",
    "ts-plugin-sort-import-suggestions": "^1.0.4",
    "@total-typescript/ts-reset": "^0.6.1",
    "lint-staged": "^15.2.2",
    "typescript": "^5.4.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "header-max-length": [
        1,
        "always",
        100
      ]
    }
  }
}
